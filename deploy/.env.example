# Application Configuration
PORT=8080
GIN_MODE=release

# Database Configuration
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=fraud_detection
DB_USER=fraud_user
DB_PASSWORD=fraud_password
DB_SSLMODE=disable

# NATS Configuration
NATS_ENABLED=true
NATS_URL=nats://nats:4222
NATS_SUBJECT=transactions
NATS_QUEUE_GROUP=fraud-processor

# Monitoring Configuration
MONITORING_ENABLED=true